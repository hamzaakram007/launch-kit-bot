# NeonGulf Launch Kit Bot — marketing site (Vercel)
# Set these in Vercel → Project → Settings → Environment Variables.
# Never commit real secrets. Discord bot token does NOT belong on Vercel.

# Public Discord application (client) ID — used to build the “Add to Discord” invite URL
NEXT_PUBLIC_DISCORD_CLIENT_ID=

# Optional override: full OAuth2 invite URL (if set, used instead of building from CLIENT_ID)
# Example permissions: Manage Roles + Send Messages + Embed Links + Use Application Commands
# = 268445696
NEXT_PUBLIC_DISCORD_INVITE_URL=

# Site URL (canonical / OG). Production default is https://bot.neongulf.com
NEXT_PUBLIC_SITE_URL=https://bot.neongulf.com
