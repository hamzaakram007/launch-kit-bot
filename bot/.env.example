# Discord bot secrets — never commit real values.
# Copy to bot/.env (gitignored) or export in your host panel (Fly/VPS).

# Required to connect and register slash commands
DISCORD_TOKEN=
CLIENT_ID=

# Optional: register commands to one guild instantly (dev). Leave empty for global.
GUILD_ID=

# Optional: enable educational scam-link warn (needs Message Content Intent in Discord Portal)
SCAM_WARN_ENABLED=false

# Optional: max FAQ buttons posted by /faq (1–5). Default 5.
FAQ_MAX=5

# Optional: cooldown seconds between heavy commands per user (default 3)
COMMAND_COOLDOWN_SECONDS=3
